[gd_scene format=3]

[ext_resource type="Script" path="res://addons/animation_track_interpolator/track_interpolator_dock.gd" id="1_dock"]

[node name="AnimationTrackInterpolator" type="VBoxContainer"]
script = ExtResource("1_dock")

[node name="TargetGrid" type="GridContainer" parent="."]
columns = 2

[node name="PlayerLabel" type="Label" parent="TargetGrid"]
text = "AnimationPlayer"

[node name="PlayerRow" type="HBoxContainer" parent="TargetGrid"]
size_flags_horizontal = 3

[node name="PlayerOption" type="OptionButton" parent="TargetGrid/PlayerRow"]
unique_name_in_owner = true
size_flags_horizontal = 3
tooltip_text = "当前编辑场景中的 AnimationPlayer（带库名的动画会在动画下拉框里显示为 库名/动画名）"

[node name="RefreshButton" type="Button" parent="TargetGrid/PlayerRow"]
unique_name_in_owner = true
tooltip_text = "重新扫描当前编辑场景中的 AnimationPlayer，并保留原来的选择"
text = "刷新"

[node name="AnimLabel" type="Label" parent="TargetGrid"]
text = "动画"

[node name="AnimOption" type="OptionButton" parent="TargetGrid"]
unique_name_in_owner = true
size_flags_horizontal = 3

[node name="TrackLabel" type="Label" parent="TargetGrid"]
text = "轨道"

[node name="TrackOption" type="OptionButton" parent="TargetGrid"]
unique_name_in_owner = true
size_flags_horizontal = 3
tooltip_text = "只有数值类轨道（值 / 位置 3D / 旋转 3D / 缩放 3D）可以被插值，其余轨道不可选"

[node name="InfoLabel" type="Label" parent="."]
unique_name_in_owner = true
